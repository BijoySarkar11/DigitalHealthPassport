<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.login.RoleSelectionController">

    <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@../icons/bg.png" />
        </image>
        <effect>
            <BoxBlur height="15.0" iterations="3" width="15.0" />
        </effect>
      <cursor>
         <Cursor fx:constant="WAIT" />
      </cursor>
    </ImageView>

    <VBox alignment="CENTER" spacing="30.0" style="-fx-padding: 40;">

        <HBox alignment="CENTER" spacing="10.0">
            <Label style="-fx-font-size: 40px; -fx-text-fill: #1E4D45; -fx-font-weight: bold;" text="✚" />
            <VBox alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2F4F4F;" text="DIGITAL HEALTH" />
                <Label style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #1E4D45;" text="PASSPORT" />
            </VBox>
        </HBox>

        <VBox alignment="CENTER" maxWidth="600.0" spacing="20.0">

            <HBox alignment="CENTER" onMouseClicked="#handleDoctorLogin" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" spacing="15.0" style="-fx-background-color: #26463D; -fx-background-radius: 30; -fx-padding: 25 35; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">

                <VBox alignment="CENTER" spacing="2.0">
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="Doctor Portal" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #A3CFC0;" text="Manage patients and tests" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER" onMouseClicked="#handlePatientLogin" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" spacing="15.0" style="-fx-background-color: #7DBFA6; -fx-background-radius: 30; -fx-padding: 25 35; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);">

                <VBox alignment="CENTER" spacing="2.0">
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="Patient Portal" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #E0F2F1;" text="View health records and prescriptions" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER" onMouseClicked="#handleAdminLogin" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" spacing="15.0" style="-fx-background-color: #E8F3EE; -fx-background-radius: 30; -fx-padding: 25 35; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <VBox alignment="CENTER" spacing="2.0">
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #26463D;" text="Admin Portal" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #5C8D7D;" text="Manage system users and data" />
                </VBox>
            </HBox>

        </VBox>
    </VBox>

    <Button onAction="#handleRequestAdminStatus" onMouseEntered="#handleButtonEnter" onMouseExited="#handleButtonExit" style="-fx-background-color: #26463D; -fx-text-fill: #FFFFFF; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-font-size: 13px;" text="Request for Admin Status" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets bottom="30.0" right="30.0" />
        </StackPane.margin>
            onAction="#handleRequestAdminStatus"
            StackPane.alignment="BOTTOM_RIGHT"
            style="-fx-background-color: #26463D; -fx-text-fill: #FFFFFF; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-font-size: 13px;">
        <StackPane.margin>
            <Insets bottom="30.0" right="30.0" />
        </StackPane.margin>
    </Button>

</StackPane>
