<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="TOP_CENTER" style="-fx-background-color: #F8FAFC; -fx-font-family: 'Segoe UI', sans-serif;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.login.DoctorLoginController">

    <padding>
        <Insets bottom="20.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 5 0 5 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <Label text="✚" style="-fx-font-size: 50px; -fx-text-fill: #2563EB;" />

        <VBox alignment="CENTER_LEFT" spacing="0.0">
            <Label text="DIGITAL HEALTH" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
            <Label text="PASSPORT" style="-fx-font-size: 38px; -fx-font-weight: 900; -fx-text-fill: #2563EB;" />
        </VBox>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">

        <AnchorPane pickOnBounds="false">
            <Circle fill="#E0F2FE" radius="250.0" AnchorPane.leftAnchor="-150.0" AnchorPane.topAnchor="-150.0" />
            <Circle fill="#E0F2FE" radius="200.0" AnchorPane.bottomAnchor="-100.0" AnchorPane.rightAnchor="-100.0" />
        </AnchorPane>

        <VBox alignment="CENTER" maxHeight="550.0" maxWidth="450.0" spacing="30.0"
              style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40;">
            <effect>
                <DropShadow color="#00000015" radius="30" offsetY="10" />
            </effect>

            <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="5.0">
                <Label onMouseClicked="#handleBackToRole" text="← Back"
                       style="-fx-cursor: hand; -fx-text-fill: #94A3B8; -fx-font-size: 14px;" />

                <Label text="Doctor Login"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />

                <Label text="Enter your credentials to access the dashboard."
                       style="-fx-font-size: 15px; -fx-text-fill: #94A3B8;" />
            </VBox>

            <VBox maxWidth="Infinity" spacing="15.0">
                <VBox spacing="5.0">
                    <Label text="Username or ID" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #475569;" />

                    <TextField fx:id="usernameField" promptText="Enter your doctor ID"
                               style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #334155;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Password" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #475569;" />

                    <PasswordField fx:id="passwordField" promptText="Enter your password"
                                   style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #334155;" />
                </VBox>

                <HBox alignment="CENTER_RIGHT">
                    <Hyperlink text="Forgot Password?"
                               style="-fx-text-fill: #2563EB; -fx-font-weight: bold; -fx-border-color: transparent; -fx-padding: 0;" />
                </HBox>
            </VBox>

            <Button maxWidth="Infinity" onAction="#handleLogin" text="Log In"
                    style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(37, 99, 235, 0.3), 10, 0, 0, 4);" />

        </VBox>

    </StackPane>
</VBox>