<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.digitalhealthpassport.ui.patient.PatientDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-padding: 15 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <Label styleClass="heading-text" style="-fx-font-size: 20px;" text="Digital Health Passport" />
            <HBox HBox.hgrow="ALWAYS" /> <Button text="Log Out" styleClass="button-secondary" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="30" style="-fx-padding: 40;">

            <VBox spacing="5">
                <Label fx:id="welcomeLabel" styleClass="heading-text" text="Welcome, Patient" />
                <Label styleClass="sub-text" text="Here is your health overview" />
            </VBox>

            <HBox spacing="30">
                <VBox styleClass="card" minWidth="300" spacing="15">
                    <Label styleClass="heading-text" style="-fx-font-size: 18px;" text="My Profile" />

                    <VBox spacing="5">
                        <Label text="Patient ID" styleClass="sub-text" style="-fx-font-weight: bold;"/>
                        <Label fx:id="patientIdLabel" text="Loading..." style="-fx-font-size: 16px;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Blood Group" styleClass="sub-text" style="-fx-font-weight: bold;"/>
                        <Label fx:id="bloodGroupLabel" text="Loading..." style="-fx-font-size: 16px;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Age" styleClass="sub-text" style="-fx-font-weight: bold;"/>
                        <Label fx:id="ageLabel" text="Loading..." style="-fx-font-size: 16px;"/>
                    </VBox>
                </VBox>

                <VBox styleClass="card" spacing="20" alignment="CENTER_LEFT">
                    <Label styleClass="heading-text" style="-fx-font-size: 18px;" text="Quick Actions" />

                    <Button text="🔍 Search Doctors" styleClass="button-primary" style="-fx-font-size: 16px; -fx-padding: 15 30;" onAction="#handleSearchDoctors"/>

                    <Label styleClass="sub-text" text="Find specialists near you and book appointments." wrapText="true" maxWidth="250"/>
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>