<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.patient.PatientDashboardController">

    <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@../icons/bg.png" />
        </image>
        <effect>
            <BoxBlur height="15.0" iterations="3" width="15.0" />
        </effect>
    </ImageView>

    <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 30;">

        <HBox alignment="CENTER" spacing="10.0">
            <Label style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #1E4D45; -fx-letter-spacing: 2;" text="PATIENT PORTAL" />
        </HBox>

        <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">

            <VBox alignment="TOP_CENTER" maxWidth="300.0" minWidth="300.0" spacing="20.0" style="-fx-background-color: #E8F3EE; -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <VBox prefHeight="20.0" />

                <VBox alignment="CENTER" spacing="5.0">
                    <Label fx:id="patientNameLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Pranty" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #5C8D7D;" text="Patient ID: PT-000001" />
                </VBox>

                <Line endX="200.0" stroke="#7DBFA6" strokeWidth="0.5" />

                <VBox spacing="15.0" style="-fx-padding: 10 0;">
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label style="-fx-font-size: 20px; -fx-text-fill: #26463D;" text="📅" />
                        <VBox>
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" text="Date of Birth" />
                            <Label fx:id="dobLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="04/01/2005" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label style="-fx-font-size: 20px; -fx-text-fill: #26463D;" text="⚥" />
                        <VBox>
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" text="Gender" />
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Female" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label style="-fx-font-size: 20px; -fx-text-fill: #26463D;" text="📞" />
                        <VBox>
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" text="Phone No" />
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="017********" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label style="-fx-font-size: 20px; -fx-text-fill: #26463D;" text="♥" />
                        <VBox>
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" text="Blood Group" />
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="AB+" />
                        </VBox>
                    </HBox>
                </VBox>

                <VBox VBox.vgrow="ALWAYS" />

                <Button maxWidth="Infinity" style="-fx-background-color: #26463D; -fx-border-radius: 50; -fx-border-color: #26463D; -fx-text-fill: #FFFFFF; -fx-background-radius: 15; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" text="Edit Profile" />

                <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-border-color: #26463D; -fx-border-radius: 50; -fx-padding: 10; -fx-cursor: hand;" text="LOG OUT" />

            </VBox>

            <VBox maxWidth="900.0" spacing="20.0" style="-fx-background-color: rgba(255,255,255,0.85); -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 20; -fx-font-weight: bold;" text="Health Records" />
                    <Button style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-cursor: hand;" text="Prescriptions" />
                    <Button style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-cursor: hand;" text="Test Reports" />
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER">
                    <VBox spacing="25.0">

                        <VBox spacing="10.0">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Vitals" />
                            <HBox spacing="15.0">
                                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" text="Age" />
                                    <Label fx:id="ageLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="21 Yrs" />
                                </VBox>
                                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" text="Height" />
                                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="160 cm" />
                                </VBox>
                                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" text="Weight" />
                                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="60 kg" />
                                </VBox>
                                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" text="BMI" />
                                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="23.4 (Normal)" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="10.0">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Medical History" />
                        </VBox>

                        <VBox spacing="10.0">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Upcoming Appointment" />
                        </VBox>

                        <VBox spacing="10.0">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Recent Tests" />
                        </VBox>

                    </VBox>
                </ScrollPane>

            </VBox>

        </HBox>

    </VBox>
</StackPane>
