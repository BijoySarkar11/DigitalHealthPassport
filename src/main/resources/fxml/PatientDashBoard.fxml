<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.patient.PatientDashboardController">

    <ImageView fitWidth="${rootPane.width}" fitHeight="${rootPane.height}" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@../icons/bg.png" />
        </image>
        <effect>
            <BoxBlur height="15.0" width="15.0" iterations="3" />
        </effect>
    </ImageView>

    <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 30;">

        <HBox alignment="CENTER" spacing="10.0">
            <Label text="🧘" style="-fx-font-size: 30px; -fx-text-fill: #1E4D45;" />
            <Label text="PATIENT PORTAL" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #1E4D45; -fx-letter-spacing: 2;" />
        </HBox>

        <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">

            <VBox alignment="TOP_CENTER" minWidth="300.0" maxWidth="300.0" spacing="20.0"
                  style="-fx-background-color: #E8F3EE; -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <VBox prefHeight="20.0" />

                <VBox alignment="CENTER" spacing="5.0">
                    <Label fx:id="patientNameLabel" text="Pranty" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                    <Label text="Patient ID: PT-0025235" style="-fx-font-size: 14px; -fx-text-fill: #5C8D7D;" />
                </VBox>

                <Line endX="200.0" stroke="#7DBFA6" strokeWidth="0.5" />

                <VBox spacing="15.0" style="-fx-padding: 10 0;">
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="📅" style="-fx-font-size: 20px; -fx-text-fill: #26463D;" />
                        <VBox>
                            <Label text="Date of Birth" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label fx:id="dobLabel" text="04/01/2005" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="⚥" style="-fx-font-size: 20px; -fx-text-fill: #26463D;" />
                        <VBox>
                            <Label text="Gender" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label text="Female" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="📞" style="-fx-font-size: 20px; -fx-text-fill: #26463D;" />
                        <VBox>
                            <Label text="Phone No" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label text="017********" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="🩸" style="-fx-font-size: 20px; -fx-text-fill: #26463D;" />
                        <VBox>
                            <Label text="Blood Group" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label text="AB+" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>
                </VBox>

                <VBox VBox.vgrow="ALWAYS" />

                <Button text="Edit Profile" maxWidth="Infinity"
                        style="-fx-background-color: #7DBFA6; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" />

                <Button text="LOG OUT" maxWidth="Infinity" onAction="#handleLogout"
                        style="-fx-background-color: transparent; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-border-color: #26463D; -fx-border-radius: 15; -fx-padding: 10; -fx-cursor: hand;" />

            </VBox>

            <VBox spacing="20.0" HBox.hgrow="ALWAYS" maxWidth="900.0"
                  style="-fx-background-color: rgba(255,255,255,0.85); -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button text="Health Records" style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 20; -fx-font-weight: bold;" />
                    <Button text="Prescriptions" style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-cursor: hand;" />
                    <Button text="Test Reports" style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-cursor: hand;" />
                </HBox>

                <ScrollPane fitToWidth="true" vbarPolicy="NEVER" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                    <VBox spacing="25.0">

                        <VBox spacing="10.0">
                            <Label text="Vitals" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                            <HBox spacing="15.0">
                                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                    <Label text="🎂 Age" style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" />
                                    <Label fx:id="ageLabel" text="21 Yrs" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                </VBox>
                                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                    <Label text="📏 Height" style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" />
                                    <Label text="165 cm" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                </VBox>
                                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                    <Label text="⚖️ Weight" style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" />
                                    <Label text="55 kg" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                </VBox>
                                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                    <Label text="📊 BMI" style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" />
                                    <Label text="20.2" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="10.0">
                            <Label text="Medical History" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>

                        <VBox spacing="10.0">
                            <Label text="Upcoming Appointment" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>

                        <VBox spacing="10.0">
                            <Label text="Recent Tests" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>

                    </VBox>
                </ScrollPane>

            </VBox>

        </HBox>

    </VBox>
</StackPane>