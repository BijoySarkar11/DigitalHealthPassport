<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.patient.PatientDashboardController">

    <ImageView fitWidth="${rootPane.width}" fitHeight="${rootPane.height}" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@../icons/bg.png" />
        </image>
        <effect>
            <BoxBlur height="15.0" width="15.0" iterations="3" />
        </effect>
    </ImageView>

    <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 30;">

        <HBox alignment="CENTER" spacing="10.0">
            <Label text="🧘" style="-fx-font-size: 30px; -fx-text-fill: #1E4D45;" />
            <Label text="PATIENT PORTAL" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #1E4D45; -fx-letter-spacing: 2;" />
        </HBox>

        <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">

            <VBox alignment="TOP_CENTER" minWidth="300.0" maxWidth="300.0" spacing="20.0"
                  style="-fx-background-color: #E8F3EE; -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <VBox prefHeight="20.0" />
                <VBox alignment="CENTER" spacing="5.0">
                    <Label fx:id="patientNameLabel" text="Pranty" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                    <Label text="Patient ID: PT-0025235" style="-fx-font-size: 14px; -fx-text-fill: #5C8D7D;" />
                </VBox>
                <Line endX="200.0" stroke="#7DBFA6" strokeWidth="0.5" />

                <VBox spacing="15.0" style="-fx-padding: 10 0;">
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="📅" style="-fx-font-size: 20px; -fx-text-fill: #26463D;" />
                        <VBox>
                            <Label text="Date of Birth" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label fx:id="dobLabel" text="04/01/2005" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="⚥" style="-fx-font-size: 20px; -fx-text-fill: #26463D;" />
                        <VBox>
                            <Label text="Gender" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label text="Female" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="📞" style="-fx-font-size: 20px; -fx-text-fill: #26463D;" />
                        <VBox>
                            <Label text="Phone No" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label text="017********" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="🩸" style="-fx-font-size: 20px; -fx-text-fill: #26463D;" />
                        <VBox>
                            <Label text="Blood Group" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label text="AB+" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>
                </VBox>
                <VBox VBox.vgrow="ALWAYS" />
                <Button text="Edit Profile" maxWidth="Infinity" style="-fx-background-color: #7DBFA6; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" />
                <Button text="LOG OUT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-border-color: #26463D; -fx-border-radius: 15; -fx-padding: 10; -fx-cursor: hand;" />
            </VBox>

            <VBox spacing="20.0" HBox.hgrow="ALWAYS" maxWidth="900.0"
                  style="-fx-background-color: rgba(255,255,255,0.85); -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <ScrollPane fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 5 0;">
                        <Button fx:id="btnHealthRecords" text="Health Records" onAction="#showHealthRecords"
                                style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;" />

                        <Button fx:id="btnPrescriptions" text="Prescriptions" onAction="#showPrescriptions"
                                style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-cursor: hand;" />

                        <Button fx:id="btnTestReports" text="Test Reports" onAction="#showTestReports"
                                style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-cursor: hand;" />

                        <Button fx:id="btnDailyReminders" text="Daily Reminders" onAction="#showDailyReminders"
                                style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-cursor: hand;" />

                        <Button fx:id="btnSearchDoctors" text="Search Doctors" onAction="#showSearchDoctors"
                                style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </HBox>
                </ScrollPane>

                <ScrollPane fitToWidth="true" vbarPolicy="NEVER" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                    <StackPane>

                        <VBox fx:id="viewHealthRecords" spacing="25.0">
                            <VBox spacing="10.0">
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Vitals" />
                                <HBox spacing="15.0">
                                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" text="Age" />
                                        <Label fx:id="ageLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="21 Yrs" />
                                    </VBox>
                                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" text="Height" />
                                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="160 cm" />
                                    </VBox>
                                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" text="Weight" />
                                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="60 kg" />
                                    </VBox>
                                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" text="BMI" />
                                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="23.4 (Normal)" />
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox spacing="10.0">
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Medical History" />
                                <HBox spacing="10.0">
                                    <Label text="Type 2 Diabetes" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                    <Label text="Hypertension" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                    <Label text="Allergy: Penicillin" style="-fx-background-color: #FEE2E2; -fx-text-fill: #991B1B; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                </HBox>
                            </VBox>

                            <VBox spacing="10.0">
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Upcoming Appointment" />
                                <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <VBox alignment="CENTER" spacing="2.0" style="-fx-background-color: #E8F3EE; -fx-background-radius: 10; -fx-padding: 10 15;">
                                        <Label text="APR" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5C8D7D;" />
                                        <Label text="25" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #1E4D45;" />
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="General Checkup" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                        <Label text="Dr. Sarah Johnson • City General Hospital" style="-fx-font-size: 13px; -fx-text-fill: #5C8D7D;" />
                                        <HBox spacing="5.0" alignment="CENTER_LEFT">
                                            <Label text="🕒 09:30 AM" style="-fx-font-size: 12px; -fx-text-fill: #7DBFA6; -fx-font-weight: bold;" />
                                        </HBox>
                                    </VBox>
                                    <Button text="Reschedule" style="-fx-background-color: transparent; -fx-border-color: #7DBFA6; -fx-border-radius: 20; -fx-text-fill: #7DBFA6; -fx-font-weight: bold; -fx-cursor: hand;" />
                                </HBox>
                            </VBox>

                            <VBox spacing="10.0">
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Recent Tests" />
                                <VBox spacing="10.0">
                                    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 5, 0, 0, 2);">
                                        <Label text="🩸" style="-fx-font-size: 24px;" />
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <Label text="Complete Blood Count (CBC)" style="-fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                            <Label text="City General Hospital • Normal" style="-fx-font-size: 12px; -fx-text-fill: #059669; -fx-font-weight: bold;" />
                                        </VBox>
                                        <Label text="Feb 10" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </VBox>

                        <VBox fx:id="viewPrescriptions" spacing="30.0" visible="false">
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="My Care Providers" />
                            <Label text="Select a provider to view detailed prescriptions." style="-fx-text-fill: #5C8D7D;" />

                            <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-cursor: hand;">
                                <VBox alignment="CENTER" style="-fx-background-color: #E0F2F1; -fx-background-radius: 15; -fx-padding: 15;">
                                    <Label text="🏥" style="-fx-font-size: 24px;" />
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="City General Hospital" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    <Label text="Dr. Sarah Johnson • Cardiology" style="-fx-font-size: 14px; -fx-text-fill: #5C8D7D;" />
                                    <Label text="Last Visit: Feb 10, 2026" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
                                </VBox>
                                <Button text="View Medicines" style="-fx-background-color: transparent; -fx-border-color: #26463D; -fx-border-radius: 20; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-cursor: hand;" />
                            </HBox>

                            <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-cursor: hand;">
                                <VBox alignment="CENTER" style="-fx-background-color: #FFF3E0; -fx-background-radius: 15; -fx-padding: 15;">
                                    <Label text="🩺" style="-fx-font-size: 24px;" />
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Specialist Care Clinic" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    <Label text="Dr. A. Rahman • General Medicine" style="-fx-font-size: 14px; -fx-text-fill: #5C8D7D;" />
                                    <Label text="Last Visit: Jan 15, 2026" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
                                </VBox>
                                <Button text="View Medicines" style="-fx-background-color: transparent; -fx-border-color: #26463D; -fx-border-radius: 20; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-cursor: hand;" />
                            </HBox>
                        </VBox>

                        <VBox fx:id="viewTestReports" spacing="25.0" visible="false">
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Lab Reports" />
                            <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                <VBox alignment="CENTER" style="-fx-background-color: #F1F5F9; -fx-background-radius: 10; -fx-padding: 10;">
                                    <Label text="📄" style="-fx-font-size: 24px;" />
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Complete Blood Count (CBC)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    <Label text="Feb 10, 2026 • City Diagnostic Center" style="-fx-font-size: 13px; -fx-text-fill: #5C8D7D;" />
                                    <Label text="Ref: Dr. Sarah Johnson" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" />
                                </VBox>
                                <Button text="Download" style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 15; -fx-font-weight: bold; -fx-cursor: hand;" />
                            </HBox>
                            <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                <VBox alignment="CENTER" style="-fx-background-color: #F0FDF4; -fx-background-radius: 10; -fx-padding: 10;">
                                    <Label text="🩻" style="-fx-font-size: 24px;" />
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Chest X-Ray (PA View)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    <Label text="Jan 28, 2026 • Global Lab Services" style="-fx-font-size: 13px; -fx-text-fill: #5C8D7D;" />
                                    <Label text="Ref: Dr. A. Rahman" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" />
                                </VBox>
                                <Button text="Download" style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 15; -fx-font-weight: bold; -fx-cursor: hand;" />
                            </HBox>
                        </VBox>

                        <VBox fx:id="viewDailyReminders" spacing="25.0" visible="false">
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Daily Medication Schedule" />

                            <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                <VBox alignment="CENTER" style="-fx-background-color: #F1F5F9; -fx-background-radius: 50; -fx-padding: 12;">
                                    <Label text="💊" style="-fx-font-size: 20px;" />
                                </VBox>
                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="Metformin" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    <Label text="500mg • Before Meals" style="-fx-font-size: 13px; -fx-text-fill: #5C8D7D;" />
                                </VBox>
                                <HBox spacing="5.0">
                                    <Label text="08:00 AM" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-padding: 5 10; -fx-background-radius: 10; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <Label text="08:00 PM" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-padding: 5 10; -fx-background-radius: 10; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                </HBox>
                            </HBox>

                            <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                <VBox alignment="CENTER" style="-fx-background-color: #F1F5F9; -fx-background-radius: 50; -fx-padding: 12;">
                                    <Label text="💊" style="-fx-font-size: 20px;" />
                                </VBox>
                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="Lisinopril" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    <Label text="10mg • After Breakfast" style="-fx-font-size: 13px; -fx-text-fill: #5C8D7D;" />
                                </VBox>
                                <HBox spacing="5.0">
                                    <Label text="09:00 AM" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-padding: 5 10; -fx-background-radius: 10; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                </HBox>
                            </HBox>
                        </VBox>

                        <VBox fx:id="viewSearchDoctors" spacing="25.0" visible="false">
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" text="Book an Appointment" />

                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                                <TextField promptText="Search Doctor or Hospital..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                                <Line startY="0" endY="20" stroke="#E0E0E0" />
