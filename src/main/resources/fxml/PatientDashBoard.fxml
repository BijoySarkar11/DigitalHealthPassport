                            <Label text="Top Doctors" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />

                            <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                <VBox alignment="CENTER" style="-fx-background-color: #E8F3EE; -fx-background-radius: 50; -fx-padding: 15; -fx-min-width: 60; -fx-min-height: 60;">
                                    <Label text="👨‍⚕️" style="-fx-font-size: 30px;" />
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Dr. Sarah Johnson" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    <Label text="Cardiologist • City General Hospital" style="-fx-font-size: 14px; -fx-text-fill: #5C8D7D;" />
                                    <Label text="⭐ 4.9 (120 Reviews)" style="-fx-font-size: 12px; -fx-text-fill: #F59E0B; -fx-font-weight: bold;" />
