<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" style="-fx-background-color: linear-gradient(to bottom right, #A8D1C0, #E0ECE6, #F8FAFC);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.doctor.DoctorDashboardController">

    <left>
        <VBox spacing="10.0" prefWidth="260.0" style="-fx-background-color: #26463D; -fx-background-radius: 25; -fx-padding: 30 20; -fx-effect: dropshadow(three-pass-box, rgba(38, 70, 61, 0.25), 30, 0, 5, 5);">

            <BorderPane.margin>
                <Insets top="25.0" bottom="25.0" left="25.0" right="10.0" />
            </BorderPane.margin>

            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 0 30 0;">
                <Label text="✚" style="-fx-text-fill: #A3CFC0; -fx-font-size: 28px; -fx-font-weight: bold;" />
                <VBox alignment="CENTER_LEFT" spacing="0">
                    <Label text="DIGITAL HEALTH" style="-fx-text-fill: #A3CFC0; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1;" />
                    <Label text="PASSPORT" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900; -fx-letter-spacing: 1;" />
                </VBox>
            </HBox>

            <HBox spacing="12.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 20 0;">
                <VBox alignment="CENTER" style="-fx-background-color: #A3CFC0; -fx-background-radius: 50; -fx-min-width: 45; -fx-min-height: 45;">
                    <Label text="👨‍⚕️" style="-fx-font-size: 24px; -fx-font-family: 'Segoe UI Emoji';" />
                </VBox>
                <VBox spacing="2.0">
                    <Label fx:id="doctorNameLabel" text="Dr. S. Johnson" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;" />
                    <Label fx:id="doctorIdLabel" text="ID: DOC-001" style="-fx-text-fill: #A3CFC0; -fx-font-size: 11px;" />
                </VBox>
            </HBox>

            <Button fx:id="btnDashboard" text="📊   Dashboard Overview" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showDashboard"
                    style="-fx-background-color: #1B362F; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" />

            <Button fx:id="btnPatients" text="👥   My Patients" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showPatients"
                    style="-fx-background-color: transparent; -fx-text-fill: #A3CFC0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" />

            <Button fx:id="btnAppointments" text="📅   Appointments" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showAppointments"
                    style="-fx-background-color: transparent; -fx-text-fill: #A3CFC0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" />

            <VBox VBox.vgrow="ALWAYS" />

            <Button text="⚙️   Settings" alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #A3CFC0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" />
            <Button fx:id="btnLogout" text="🚪   Logout" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #FCA5A5; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" />
        </VBox>
    </left>

    <center>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 25 35 10 25;">
                <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="400.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 8 15; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.05), 10, 0, 0, 2);">
                    <Label text="🔍" style="-fx-text-fill: #9CA3AF; -fx-font-family: 'Segoe UI Emoji';" />
                    <TextField promptText="Search patients, ID, or records..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-prompt-text-fill: #9CA3AF;" HBox.hgrow="ALWAYS" />
                </HBox>
                <HBox HBox.hgrow="ALWAYS" />
                <Label text="🔔" style="-fx-font-size: 18px; -fx-text-fill: #26463D; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji';" />
            </HBox>

            <ScrollPane fitToWidth="true" fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <StackPane style="-fx-background-color: transparent;">

                    <VBox fx:id="viewDashboard" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;">

                        <Label text="Overview" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 28px;" />

                        <HBox spacing="20.0">
                            <VBox HBox.hgrow="ALWAYS" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                <HBox alignment="TOP_LEFT" spacing="10.0">
                                    <VBox>
                                        <Label text="Total Patients" style="-fx-text-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                        <Label text="Managed cases" style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;" />
                                    </VBox>
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Label text="👥" alignment="CENTER" style="-fx-text-fill: #10B981; -fx-background-color: #ECFDF5; -fx-background-radius: 12; -fx-min-width: 45; -fx-min-height: 45; -fx-font-size: 20px; -fx-font-family: 'Segoe UI Emoji';" />
                                </HBox>
                                <Label text="178" style="-fx-text-fill: #111827; -fx-font-weight: 900; -fx-font-size: 38px; -fx-padding: -10 0 0 0;" />
                                <HBox alignment="CENTER_LEFT" spacing="5.0">
                                    <Label text="📈" style="-fx-text-fill: #10B981; -fx-font-size: 12px; -fx-font-family: 'Segoe UI Emoji';"/>
                                    <Label text="142 Active • 36 Recovered" style="-fx-text-fill: #047857; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                </HBox>
                            </VBox>

                            <VBox HBox.hgrow="ALWAYS" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                <HBox alignment="TOP_LEFT" spacing="10.0">
                                    <VBox>
                                        <Label text="Active Cases" style="-fx-text-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                        <Label text="Requires action" style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;" />
                                    </VBox>
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Label text="🏥" alignment="CENTER" style="-fx-text-fill: #EF4444; -fx-background-color: #FEF2F2; -fx-background-radius: 12; -fx-min-width: 45; -fx-min-height: 45; -fx-font-size: 20px; -fx-font-family: 'Segoe UI Emoji';" />
                                </HBox>
                                <Label text="33" style="-fx-text-fill: #111827; -fx-font-weight: 900; -fx-font-size: 38px; -fx-padding: -10 0 0 0;" />
                                <HBox alignment="CENTER_LEFT" spacing="5.0">
                                    <Label text="⚠️" style="-fx-text-fill: #B91C1C; -fx-font-size: 12px; -fx-font-family: 'Segoe UI Emoji';"/>
                                    <Label text="2 Critical cases flagged" style="-fx-text-fill: #B91C1C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                </HBox>
                            </VBox>

                            <VBox HBox.hgrow="ALWAYS" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                <HBox alignment="TOP_LEFT" spacing="10.0">
                                    <VBox>
                                        <Label text="Today's Appts" style="-fx-text-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                        <Label text="Schedule" style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;" />
                                    </VBox>
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Label text="📅" alignment="CENTER" style="-fx-text-fill: #F59E0B; -fx-background-color: #FFFBEB; -fx-background-radius: 12; -fx-min-width: 45; -fx-min-height: 45; -fx-font-size: 20px; -fx-font-family: 'Segoe UI Emoji';" />
                                </HBox>
                                <Label text="76" style="-fx-text-fill: #111827; -fx-font-weight: 900; -fx-font-size: 38px; -fx-padding: -10 0 0 0;" />
                                <HBox alignment="CENTER_LEFT" spacing="5.0">
                                    <Label text="⏳" style="-fx-text-fill: #D97706; -fx-font-size: 12px; -fx-font-family: 'Segoe UI Emoji';"/>
                                    <Label text="54 Completed • 22 Upcoming" style="-fx-text-fill: #D97706; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                </HBox>
                            </VBox>
                        </HBox>

                        <HBox spacing="25.0" VBox.vgrow="ALWAYS">
                            <VBox spacing="10.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Patient Intake Trends" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 18px;" HBox.hgrow="ALWAYS" />
                                    <Label text="↗" style="-fx-text-fill: #6B7280; -fx-font-family: 'Segoe UI Emoji';" />
                                </HBox>
                                <AreaChart fx:id="trendChart" createSymbols="false" legendVisible="false" minHeight="250.0" maxHeight="320.0"
                                           style="-fx-background-color: transparent;" animated="false"
                                           horizontalGridLinesVisible="false" verticalGridLinesVisible="false"
                                           alternativeRowFillVisible="false" alternativeColumnFillVisible="false">
                                    <xAxis><CategoryAxis side="BOTTOM" animated="false" tickLabelsVisible="true" style="-fx-tick-label-fill: #6B7280; -fx-font-size: 12px;" /></xAxis>
                                    <yAxis><NumberAxis side="LEFT" animated="false" tickLabelsVisible="true" style="-fx-tick-label-fill: #6B7280; -fx-font-size: 12px;" /></yAxis>
                                </AreaChart>
                            </VBox>

                            <VBox minWidth="320.0" maxWidth="320.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Today's Schedule" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 18px;" HBox.hgrow="ALWAYS" />
                                </HBox>

                                <VBox fx:id="scheduleVBox" spacing="15.0">
                                </VBox>

                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox fx:id="viewPatients" visible="false" managed="false" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;">
                        <VBox spacing="5.0">
                            <Label text="Patient Roster" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 32px;" />
                            <Label text="Comprehensive overview of patient diagnostics and history." style="-fx-text-fill: #4A7A68; -fx-font-size: 16px; -fx-font-weight: bold;" />
                        </VBox>

                        <VBox fx:id="patientRosterContainer" spacing="20.0" VBox.vgrow="ALWAYS">
                        </VBox>
                    </VBox>

                    <VBox fx:id="viewAppointments" visible="false" managed="false" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;">
                        <VBox spacing="5.0">
                            <Label text="Consultation Schedule" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 32px;" />
                            <Label text="Manage your upcoming patient appointments." style="-fx-text-fill: #4A7A68; -fx-font-size: 16px; -fx-font-weight: bold;" />
                        </VBox>

                        <HBox spacing="25.0" VBox.vgrow="ALWAYS">
                            <VBox fx:id="appointmentsContainer" spacing="15.0" HBox.hgrow="ALWAYS">
                            </VBox>

                            <VBox minWidth="400.0" maxWidth="400.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                <VBox spacing="5.0">
                                    <Label text="Quick Prescribe" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 18px;" />
                                    <Label text="Issue a new prescription for first-time or walk-in consultations." style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" wrapText="true" />
                                </VBox>

                                <VBox spacing="15.0" style="-fx-padding: 10 0 0 0;" VBox.vgrow="ALWAYS">
                                    <VBox spacing="5.0">
                                        <Label text="Patient ID / System Email" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                        <HBox spacing="10.0">
                                            <TextField promptText="e.g. PT-0025235" HBox.hgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                                            <Button text="Verify" style="-fx-background-color: #E8F3EE; -fx-text-fill: #115E59; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="5.0">
                                        <Label text="Diagnosis Summary" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                        <TextField promptText="e.g. Acute Bronchitis" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                                    </VBox>

                                    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                                        <Label text="Medications &amp; Dosage" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                        <TextArea promptText="1. Amoxicillin 500mg - 3 times/day (7 days)&#10;2. Paracetamol 500mg - When needed" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS" />
                                    </VBox>

                                    <Button text="➕ Issue Digital Prescription" maxWidth="Infinity" style="-fx-background-color: #115E59; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 15; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" />
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>

                </StackPane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>