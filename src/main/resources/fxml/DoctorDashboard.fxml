<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #F8FAFC; -fx-font-family: 'Segoe UI', sans-serif;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.healthpassport.ui.doctor.DoctorDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: white; -fx-padding: 15 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">

            <Label text="Doctor Portal"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />

            <HBox HBox.hgrow="ALWAYS" />

            <Button text="Log Out" onAction="#handleLogout"
                    style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #64748B; -fx-cursor: hand; -fx-padding: 8 15; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <VBox spacing="30" style="-fx-padding: 40;">

            <VBox spacing="5">
                <Label fx:id="welcomeLabel" text="Welcome, Dr. Smith"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                <Label text="Manage your patients and appointments"
                       style="-fx-font-size: 15px; -fx-text-fill: #94A3B8;" />
            </VBox>

            <HBox spacing="30">

                <VBox minWidth="300" spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">

                    <Label text="My Profile"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />

                    <VBox spacing="5">
                        <Label text="Doctor ID" style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                        <Label text="DR-5501" style="-fx-font-size: 16px; -fx-text-fill: #334155;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Department" style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                        <Label text="Cardiology" style="-fx-font-size: 16px; -fx-text-fill: #334155;"/>
                    </VBox>
                </VBox>

                <VBox spacing="20" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">

                    <Label text="Patient Management"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />

                    <HBox spacing="20">
                        <Button text="🔍 Search Patient" onAction="#handleSearchPatient"
                                style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15 30; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(5, 150, 105, 0.3), 10, 0, 0, 4);" />

                        <Button text="➕ New Patient" onAction="#handleNewPatient"
                                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15 30; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(16, 185, 129, 0.3), 10, 0, 0, 4);" />
                    </HBox>

                    <Label text="Search existing records or register a new patient admission."
                           style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" />
                </VBox>
            </HBox>

        </VBox>
    </center>
</BorderPane>