<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.doctor.DoctorDashboardController">

    <ImageView fitWidth="${rootPane.width}" fitHeight="${rootPane.height}" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@../icons/bg.png" />
        </image>
        <effect>
            <BoxBlur height="15.0" width="15.0" iterations="3" />
        </effect>
    </ImageView>

    <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 30;">

        <HBox alignment="CENTER" spacing="10.0">
            <Label text="👨‍⚕️" style="-fx-font-size: 30px;" />
            <Label text="DOCTOR PORTAL" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #1E4D45; -fx-letter-spacing: 2;" />
        </HBox>

        <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">

            <VBox alignment="TOP_CENTER" minWidth="300.0" maxWidth="300.0" spacing="20.0"
                  style="-fx-background-color: #E8F3EE; -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <VBox prefHeight="20.0" />
                <VBox alignment="CENTER" spacing="5.0">
                    <Label fx:id="doctorNameLabel" text="Dr. Sarah Johnson" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                    <Label text="Cardiologist" style="-fx-font-size: 16px; -fx-text-fill: #5C8D7D;" />
                    <Label text="ID: DOC-001" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" />
                </VBox>
                <Line endX="200.0" stroke="#7DBFA6" strokeWidth="0.5" />

                <VBox spacing="15.0" style="-fx-padding: 10 0;">
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="🏥" style="-fx-font-size: 20px;" />
                        <VBox>
                            <Label text="Hospital" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label text="City General Hospital" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="📞" style="-fx-font-size: 20px;" />
                        <VBox>
                            <Label text="Contact" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label text="+880 17********" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="📧" style="-fx-font-size: 20px;" />
                        <VBox>
                            <Label text="Email" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                            <Label text="sarah.j@cityhospital.com" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                        </VBox>
                    </HBox>
                </VBox>

                <VBox VBox.vgrow="ALWAYS" />
                <Button text="Edit Profile" maxWidth="Infinity" style="-fx-background-color: #7DBFA6; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" />
                <Button text="LOG OUT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-border-color: #26463D; -fx-border-radius: 15; -fx-padding: 10; -fx-cursor: hand;" />
            </VBox>

            <VBox spacing="20.0" HBox.hgrow="ALWAYS" maxWidth="900.0"
                  style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button fx:id="btnSearchPatient" text="Search Patient" onAction="#showSearchPatient"
                            style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;" />

                    <Button fx:id="btnAddPatient" text="Add New Patient" onAction="#showAddPatient"
                            style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-cursor: hand;" />
                </HBox>

                <ScrollPane fitToWidth="true" vbarPolicy="NEVER" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <StackPane>

                        <VBox fx:id="viewSearchPatient" spacing="25.0">
                            <Label text="Find Patient Records" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />

                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                                <TextField fx:id="searchField" promptText="Enter Patient ID or Name..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                                <Button text="Search" onAction="#handleSearch" style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" />
                            </HBox>

                            <VBox fx:id="patientDetailsContainer" spacing="20.0" visible="false" managed="false" style="-fx-padding: 10 0 0 0;">
                                <Label text="Patient Results" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #5C8D7D;" />

                                <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: #E8F3EE; -fx-background-radius: 15; -fx-padding: 20;">
                                    <VBox alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 50; -fx-padding: 15;">
                                        <Label text="👤" style="-fx-font-size: 30px;" />
                                    </VBox>
                                    <VBox spacing="2.0">
                                        <Label fx:id="resultName" text="Pranty" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                        <Label fx:id="resultId" text="Patient ID: PT-0025235" style="-fx-font-size: 14px; -fx-text-fill: #5C8D7D;" />
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" />
                                    <Button text="Full Profile" style="-fx-background-color: transparent; -fx-border-color: #26463D; -fx-border-radius: 20; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-cursor: hand;" />
                                </HBox>

                                <Label text="Clinical Actions" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                <HBox spacing="15.0">
                                    <Button text="✚ Add Prescription" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                            style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 15; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
                                    <Button text="✚ Add Test Report" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                            style="-fx-background-color: #7DBFA6; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 15; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
                                </HBox>

                                <Label text="⚠️ Medical Alerts &amp; History" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #B91C1C;" />
                                <HBox spacing="10.0">
                                    <Label text="Allergy: Penicillin" style="-fx-background-color: #FEE2E2; -fx-text-fill: #991B1B; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold; -fx-border-color: #991B1B; -fx-border-radius: 20;" />

                                    <Label text="Type 2 Diabetes" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold;" />
                                    <Label text="Hypertension" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold;" />
                                </HBox>
                                <Label text="Current Vitals" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                <HBox spacing="15.0">
                                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                        <Label text="Age" style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" />
                                        <Label text="21 Yrs" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    </VBox>
                                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                        <Label text="Height" style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" />
                                        <Label text="160 cm" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    </VBox>
                                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                        <Label text="Weight" style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" />
                                        <Label text="60 kg" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    </VBox>
                                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-min-width: 120;" HBox.hgrow="ALWAYS">
                                        <Label text="Blood Group" style="-fx-text-fill: #5C8D7D; -fx-font-size: 12px;" />
                                        <Label text="AB+" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                    </VBox>
                                </HBox>

                                <Label text="Current Medications (Daily)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <VBox alignment="CENTER" style="-fx-background-color: #F1F5F9; -fx-background-radius: 50; -fx-padding: 10;">
                                        <Label text="💊" style="-fx-font-size: 20px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="Metformin" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                        <Label text="500mg • Before Meals • 8:00 AM / 8:00 PM" style="-fx-font-size: 13px; -fx-text-fill: #5C8D7D;" />
                                    </VBox>
                                </HBox>
                                <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <VBox alignment="CENTER" style="-fx-background-color: #F1F5F9; -fx-background-radius: 50; -fx-padding: 10;">
                                        <Label text="💊" style="-fx-font-size: 20px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="Lisinopril" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                        <Label text="10mg • After Breakfast • 9:00 AM" style="-fx-font-size: 13px; -fx-text-fill: #5C8D7D;" />
                                    </VBox>
                                </HBox>

                                <Label text="Prescription History" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <VBox alignment="CENTER" style="-fx-background-color: #E0F2F1; -fx-background-radius: 15; -fx-padding: 10;">
                                        <Label text="🏥" style="-fx-font-size: 20px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="City General Hospital" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                        <Label text="Dr. Sarah Johnson • Cardiology • Feb 10, 2026" style="-fx-font-size: 13px; -fx-text-fill: #5C8D7D;" />
                                    </VBox>
                                    <Button text="View" style="-fx-background-color: transparent; -fx-border-color: #26463D; -fx-border-radius: 20; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-cursor: hand;" />
                                </HBox>

                                <Label text="All Lab Reports (History)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                <VBox spacing="10.0">
                                    <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                        <VBox alignment="CENTER" style="-fx-background-color: #F1F5F9; -fx-background-radius: 10; -fx-padding: 10;">
                                            <Label text="📄" style="-fx-font-size: 20px;" />
                                        </VBox>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <Label text="Complete Blood Count (CBC)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                            <Label text="City Diagnostic Center • Ref: Dr. Sarah Johnson" style="-fx-font-size: 13px; -fx-text-fill: #5C8D7D;" />
                                            <Label text="Feb 10, 2026" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" />
                                        </VBox>
                                        <Button text="View PDF" style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 5 15; -fx-font-weight: bold; -fx-cursor: hand;" />
                                    </HBox>

                                    <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                        <VBox alignment="CENTER" style="-fx-background-color: #F0FDF4; -fx-background-radius: 10; -fx-padding: 10;">
                                            <Label text="🩻" style="-fx-font-size: 20px;" />
                                        </VBox>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <Label text="Chest X-Ray (PA View)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                            <Label text="Global Lab Services • Ref: Dr. A. Rahman" style="-fx-font-size: 13px; -fx-text-fill: #5C8D7D;" />
                                            <Label text="Jan 28, 2026" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" />
                                        </VBox>
                                        <Button text="View PDF" style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 5 15; -fx-font-weight: bold; -fx-cursor: hand;" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </VBox>

                        <VBox fx:id="viewAddPatient" spacing="25.0" visible="false">
                            <Label text="Register New Patient" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                            <VBox spacing="15.0" maxWidth="600.0">
                                <VBox spacing="5.0">
                                    <Label text="Full Name" style="-fx-font-weight: bold; -fx-text-fill: #26463D;" />
                                    <TextField promptText="e.g. John Doe" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                </VBox>
                                <HBox spacing="15.0">
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Date of Birth" style="-fx-font-weight: bold; -fx-text-fill: #26463D;" />
                                        <DatePicker maxWidth="Infinity" style="-fx-background-radius: 10;" />
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Gender" style="-fx-font-weight: bold; -fx-text-fill: #26463D;" />
                                        <ComboBox promptText="Select" maxWidth="Infinity" style="-fx-background-radius: 10;" />
                                    </VBox>
                                </HBox>
                                <HBox spacing="15.0">
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Phone Number" style="-fx-font-weight: bold; -fx-text-fill: #26463D;" />
                                        <TextField promptText="+880..." style="-fx-background-radius: 10; -fx-padding: 10;" />
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Blood Group" style="-fx-font-weight: bold; -fx-text-fill: #26463D;" />
                                        <ComboBox promptText="Select" maxWidth="Infinity" style="-fx-background-radius: 10;" />
                                    </VBox>
                                </HBox>
                                <Button text="Save Patient" style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12 20; -fx-font-weight: bold; -fx-cursor: hand;" />
                            </VBox>
                        </VBox>

                    </StackPane>
                </ScrollPane>

            </VBox>
        </HBox>
    </VBox>
</StackPane>