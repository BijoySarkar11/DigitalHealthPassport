<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="TOP_CENTER" styleClass="root-background" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.login.AdminLoginController">

    <padding>
        <Insets bottom="20.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER" spacing="15.0" styleClass="heading-container">
        <Label styleClass="logo-icon" text="✚" />
        <VBox alignment="CENTER_LEFT" spacing="0.0">
            <Label styleClass="logo-text-top" text="DIGITAL HEALTH" />
            <Label styleClass="logo-text-bottom" text="PASSPORT" />
        </VBox>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">

        <AnchorPane pickOnBounds="false">
            <Circle fill="#E0F2FE" radius="250.0" AnchorPane.leftAnchor="-150.0" AnchorPane.topAnchor="-150.0" />
            <Circle fill="#E0F2FE" radius="200.0" AnchorPane.bottomAnchor="-100.0" AnchorPane.rightAnchor="-100.0" />
        </AnchorPane>

        <VBox alignment="CENTER" maxHeight="550.0" maxWidth="450.0" spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40;">
            <effect>
                <DropShadow color="#00000015" radius="30" offsetY="10" />
            </effect>

            <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="5.0">
                <Label onMouseClicked="#handleBackToRole" style="-fx-cursor: hand; -fx-text-fill: #94A3B8; -fx-font-size: 14px;" text="← Back" />
                <Label styleClass="form-header" text="Administrator Login" />
                <Label styleClass="form-subheader" text="Secure access for system management." />
            </VBox>

            <VBox maxWidth="Infinity" spacing="15.0">
                <VBox spacing="5.0">
                    <Label styleClass="input-label" text="Admin ID" />
                    <TextField fx:id="usernameField" promptText="Enter Admin ID" styleClass="text-field-modern" />
                </VBox>

                <VBox spacing="5.0">
                    <Label styleClass="input-label" text="Password" />
                    <PasswordField fx:id="passwordField" promptText="Enter system password" styleClass="text-field-modern" />
                </VBox>

                <HBox alignment="CENTER_RIGHT">
                    <Hyperlink styleClass="forgot-link" text="Forgot Password?" />
                </HBox>
            </VBox>

            <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="primary-button" text="Access System" />

        </VBox>

    </StackPane>
</VBox>