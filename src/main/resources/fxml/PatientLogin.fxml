<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.login.PatientLoginController">

    <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@../icons/bg.png" />
        </image>
        <effect>
            <BoxBlur height="15.0" iterations="3" width="15.0" />
        </effect>
    </ImageView>

    <VBox alignment="CENTER" spacing="30.0" style="-fx-padding: 40;">

        <HBox alignment="CENTER" spacing="10.0">
            <Label style="-fx-font-size: 40px; -fx-text-fill: #1E4D45; -fx-font-weight: bold;" text="✚" />
            <VBox alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2F4F4F;" text="DIGITAL HEALTH" />
                <Label style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #1E4D45;" text="PASSPORT" />
            </VBox>
        </HBox>

        <VBox alignment="CENTER" maxHeight="500.0" maxWidth="450.0" spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">

            <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="5.0">

                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #26463D;" text="Patient Login" />

                <!--<Label text="Enter your details to access records."
                       style="-fx-font-size: 14px; -fx-text-fill: #7DBFA6;" /> -->
            </VBox>

            <VBox maxWidth="Infinity" spacing="15.0">
                <VBox spacing="5.0">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #26463D;" text="Patient ID" />
                    <TextField fx:id="usernameField" promptText="Enter your username" style="-fx-background-color: #F5F7F6; -fx-border-color: #26463D; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #26463D;" text="Password" />
                    <PasswordField fx:id="passwordField" promptText="Enter your password" style="-fx-background-color: #F5F7F6; -fx-border-color: #26463D; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;" />
                </VBox>


            </VBox>

            <Button maxWidth="Infinity" onAction="#handleLogin" style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(125, 191, 166, 0.4), 10, 0, 0, 4);" text="Log In" />
             <Label alignment="BOTTOM_RIGHT" onMouseClicked="#handleBackToRole" style="-fx-cursor: hand; -fx-text-fill: #94A3B8; -fx-font-size: 14px; -fx-font-weight: bold;" text="← Back" textAlignment="CENTER" />

        </VBox>

    </VBox>
</StackPane>
