<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ImageView fitHeight="600.0" fitWidth="800.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../icons/bg.png" />
         </image>
         <effect>
            <BoxBlur height="15.0" iterations="3" width="15.0">
               <input>
                  <Lighting>
                     <bumpInput>
                        <Shadow />
                     </bumpInput>
                     <light>
                        <Light.Distant />
                     </light>
                  </Lighting>
               </input>
            </BoxBlur>
         </effect>
      </ImageView>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="30.0" StackPane.alignment="CENTER">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label alignment="CENTER" style="-fx-font-size: 40PX;" text="+" textAlignment="CENTER" textFill="#1e4d44" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox alignment="CENTER" maxWidth="600.0" prefHeight="364.0" prefWidth="548.0" spacing="20.0">
         <children>
            <HBox alignment="CENTER" onMouseClicked="#handleDoctorLogin" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="136.0" prefWidth="1000.0" spacing="2.0" style="-fx-background-color: #7DBFA6; -fx-background-radius: 30;">
                     <children>
                        <Label alignment="CENTER" prefHeight="32.0" prefWidth="195.0" style="-fx-font-size: 22;" text="DOCTOR PORTAL" textAlignment="CENTER" textFill="WHITE" />
                     </children>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </children></HBox>
         </children>
      </VBox>
      <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="64.0" style="-fx-background-color: #000000;" text="REQ" textFill="WHITE" StackPane.alignment="BOTTOM_RIGHT">
         <StackPane.margin>
            <Insets bottom="30.0" right="30.0" />
         </StackPane.margin>
      </Button>
   </children>
</StackPane>
