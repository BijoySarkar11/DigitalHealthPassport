<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" style="-fx-background-color: linear-gradient(to right, #A3CFC0, #F8FAFC);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.admin.AdminDashboardController">

    <left>
        <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: #26463D; -fx-background-radius: 25; -fx-padding: 30 20; -fx-effect: dropshadow(three-pass-box, rgba(38, 70, 61, 0.25), 30, 0, 5, 5);">
            <BorderPane.margin><Insets bottom="25.0" left="25.0" right="10.0" top="25.0" /></BorderPane.margin>

            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 0 30 0;">
                <Label style="-fx-text-fill: #A3CFC0; -fx-font-size: 28px; -fx-font-weight: bold;" text="✚" />
                <VBox alignment="CENTER_LEFT" spacing="0">
                    <Label style="-fx-text-fill: #A3CFC0; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1;" text="DIGITAL HEALTH" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900; -fx-letter-spacing: 1;" text="PASSPORT" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 0 0 20 0;">
                <VBox alignment="CENTER" style="-fx-background-color: #A3CFC0; -fx-background-radius: 50; -fx-min-width: 45; -fx-min-height: 45;">
                    <Label style="-fx-font-size: 24px; -fx-font-family: 'Segoe UI Emoji';" text="🛡️" />
                </VBox>
                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;" text="System Admin" />
                    <Label style="-fx-text-fill: #A3CFC0; -fx-font-size: 11px;" text="City General Hosp." />
                </VBox>
            </HBox>

            <Button fx:id="btnSearch" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showSearch" style="-fx-background-color: #1B362F; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="🔍   Search Records" />
            <Button fx:id="btnNewPatient" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showNewPatient" style="-fx-background-color: transparent; -fx-text-fill: #A3CFC0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="👤   Register Patient" />
            <Button fx:id="btnNewDoctor" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showNewDoctor" style="-fx-background-color: transparent; -fx-text-fill: #A3CFC0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="👨‍⚕️   Register Doctor" />
            <Button fx:id="btnAddTestReport" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showAddTestReport" style="-fx-background-color: transparent; -fx-text-fill: #A3CFC0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="📄   Add Test Report" />

            <VBox VBox.vgrow="ALWAYS" />

            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #A3CFC0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="⚙️   Settings" />
            <Button fx:id="btnLogout" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #FCA5A5; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="🚪   Logout" />
        </VBox>
    </left>

    <center>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 25 35 10 25;">
                <HBox HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 8 15; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.05), 10, 0, 0, 2);">
                    <Label style="-fx-text-fill: #9CA3AF; -fx-font-family: 'Segoe UI Emoji';" text="🔍" />
                    <TextField promptText="Quick search system ID..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-prompt-text-fill: #9CA3AF;" HBox.hgrow="ALWAYS" />
                </HBox>
                <Label style="-fx-font-size: 18px; -fx-text-fill: #26463D; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji';" text="🔔" />
            </HBox>

            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                <StackPane style="-fx-background-color: transparent;">

                    <VBox fx:id="viewSearch" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;">
                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 32px;" text="Database Search" />
                            <Label style="-fx-text-fill: #4A7A68; -fx-font-size: 16px; -fx-font-weight: bold;" text="Manage and edit patient or doctor records." />
                        </VBox>

                        <VBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                <TextField promptText="Search by Name or ID..." style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                <ComboBox promptText="Filter: All" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 4; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                                <Button style="-fx-background-color: #115E59; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 12 30; -fx-cursor: hand;" text="Search" />
                            </HBox>

                            <Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 18px; -fx-padding: 10 0 0 0;" text="Recent Registrations" />

                            <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 15, 0, 5, 5);">
                                    <VBox alignment="CENTER" minHeight="60.0" minWidth="60.0" style="-fx-background-color: #E8F3EE; -fx-background-radius: 50;"><Label style="-fx-font-size: 30px; -fx-font-family: 'Segoe UI Emoji';" text="👨‍⚕️" /></VBox>
                                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="10.0"><Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 18px;" text="Dr. Maruf Ahmed Tamal" /><Label style="-fx-background-color: #D1FAE5; -fx-text-fill: #065F46; -fx-padding: 3 8; -fx-background-radius: 5; -fx-font-size: 10px; -fx-font-weight: bold;" text="Doctor" /></HBox>
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 13px;" text="Cardiology • ID: DOC-001" />
                                    </VBox>
                                    <Button style="-fx-background-color: #F8FAFC; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" text="Edit Record" />
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 15, 0, 5, 5);">
                                    <VBox alignment="CENTER" minHeight="60.0" minWidth="60.0" style="-fx-background-color: #F0F9FF; -fx-background-radius: 50;"><Label style="-fx-font-size: 30px; -fx-font-family: 'Segoe UI Emoji';" text="👤" /></VBox>
                                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="10.0"><Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 18px;" text="Pranty" /><Label style="-fx-background-color: #DBEAFE; -fx-text-fill: #1E3A8A; -fx-padding: 3 8; -fx-background-radius: 5; -fx-font-size: 10px; -fx-font-weight: bold;" text="Patient" /></HBox>
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 13px;" text="Registered: Oct 20, 2026 • ID: PT-0025235" />
                                    </VBox>
                                    <Button style="-fx-background-color: #F8FAFC; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" text="Edit Record" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                    <VBox fx:id="viewNewPatient" managed="false" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;" visible="false">
                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 32px;" text="Register New Patient" />
                            <Label style="-fx-text-fill: #4A7A68; -fx-font-size: 16px; -fx-font-weight: bold;" text="Create a new Digital Health Passport for a patient." />
                        </VBox>

                        <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);" VBox.vgrow="ALWAYS">
                            <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 16px; -fx-text-fill: #111827; -fx-font-weight: bold;" text="Personal Information" />
                                    <TextField promptText="Full Name" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                                    <HBox spacing="15.0">
                                        <DatePicker maxWidth="Infinity" promptText="Date of Birth" HBox.hgrow="ALWAYS" />
                                        <ComboBox maxWidth="Infinity" promptText="Gender" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                    <TextField promptText="Phone Number" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12;" />
                                    <ComboBox maxWidth="Infinity" promptText="Blood Group" />
                                    <Label style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;" text="Residential Address" />
                                    <TextArea prefRowCount="3" style="-fx-background-color: #F8FAFC;" wrapText="true" VBox.vgrow="ALWAYS" />
                                </VBox>
                                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 16px; -fx-text-fill: #111827; -fx-font-weight: bold;" text="System Credentials" />
                                    <VBox spacing="5.0">
                                        <Label style="-fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-font-size: 12px;" text="Assigned Patient ID / Email" />
                                        <TextField promptText="e.g. PT-2026-0001" style="-fx-background-color: #F8FAFC; -fx-border-color: #115E59; -fx-border-radius: 8; -fx-padding: 12; -fx-font-weight: bold;" />
                                    </VBox>
                                    <VBox spacing="5.0">
                                        <Label style="-fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-font-size: 12px;" text="Temporary System Password" />
                                        <TextField promptText="Assign Password" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-border-radius: 8;" />
                                    </VBox>
                                    <TextField promptText="Emergency Contact Person" style="-fx-background-color: #F8FAFC; -fx-padding: 12;" />
                                    <TextField promptText="Emergency phone number" style="-fx-background-color: #F8FAFC; -fx-padding: 12;" />
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER_RIGHT"><Button style="-fx-background-color: #115E59; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 15 40; -fx-font-weight: bold;" text="Confirm &amp; Register Patient" /></HBox>
                        </VBox>
                    </VBox>

                    <VBox fx:id="viewNewDoctor" managed="false" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;" visible="false">
                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 32px;" text="Onboard New Doctor" />
                            <Label style="-fx-text-fill: #4A7A68; -fx-font-size: 16px; -fx-font-weight: bold;" text="Add a new physician to the hospital roster." />
                        </VBox>

                        <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);" VBox.vgrow="ALWAYS">
                            <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 16px; -fx-text-fill: #111827; -fx-font-weight: bold;" text="Professional Details" />
                                    <TextField promptText="Doctor Name (Full Legal Name)" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                                    <HBox spacing="15.0">
                                        <TextField promptText="Specialty (e.g. Cardiology)" style="-fx-background-color: #F8FAFC; -fx-padding: 12;" HBox.hgrow="ALWAYS" />
                                        <TextField promptText="License Number" style="-fx-background-color: #F8FAFC; -fx-padding: 12;" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                    <TextField promptText="Degrees (MBBS, MD, etc.)" style="-fx-background-color: #F8FAFC; -fx-padding: 12;" />
                                </VBox>
                                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 16px; -fx-text-fill: #111827; -fx-font-weight: bold;" text="System Credentials" />
                                    <VBox spacing="5.0">
                                        <Label style="-fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-font-size: 12px;" text="Assigned System ID / Doctor Email" />
                                        <TextField promptText="e.g. DOC-2026-0001" style="-fx-background-color: #F8FAFC; -fx-border-color: #115E59; -fx-border-radius: 8; -fx-padding: 12; -fx-font-weight: bold;" />
                                    </VBox>
                                    <VBox spacing="5.0">
                                        <Label style="-fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-font-size: 12px;" text="Temporary System Password" />
                                        <TextField promptText="Auto-generated or Manual" style="-fx-background-color: #F8FAFC; -fx-padding: 12;" />
                                    </VBox>
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER_RIGHT"><Button style="-fx-background-color: #115E59; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 15 40; -fx-font-weight: bold;" text="Register Doctor to System" /></HBox>
                        </VBox>
                    </VBox>

                    <VBox fx:id="viewAddTestReport" managed="false" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;" visible="false">
                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 32px;" text="Upload Test Report" />
                            <Label style="-fx-text-fill: #4A7A68; -fx-font-size: 16px; -fx-font-weight: bold;" text="Attach verified lab results to a patient's passport." />
                        </VBox>

                        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);" VBox.vgrow="ALWAYS">
                            <HBox spacing="15.0">
                                <TextField promptText="Verify Patient ID (e.g. PT-0025235)" style="-fx-background-color: #F8FAFC; -fx-padding: 12;" HBox.hgrow="ALWAYS" />
                                <Button style="-fx-background-color: #E8F3EE; -fx-text-fill: #115E59; -fx-font-weight: bold; -fx-padding: 0 25; -fx-min-height: 45;" text="Verify ID" />
                            </HBox>
                            <HBox spacing="15.0">
                                <ComboBox maxWidth="Infinity" promptText="Select Test Type" HBox.hgrow="ALWAYS" />
                                <DatePicker maxWidth="Infinity" promptText="Date of Test" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <TextArea prefRowCount="5" promptText="Enter Brief Results / Summary..." style="-fx-background-color: #F8FAFC;" VBox.vgrow="ALWAYS" />
                            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #F8FAFC; -fx-border-style: dashed; -fx-border-color: #CBD5E1; -fx-border-radius: 10; -fx-padding: 20;">
                                <Label style="-fx-font-size: 24px; -fx-font-family: 'Segoe UI Emoji';" text="📄" />
                                <VBox HBox.hgrow="ALWAYS"><Label style="-fx-font-weight: bold;" text="No PDF selected" /><Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;" text="Max file size: 10MB" /></VBox>
                                <Button style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 10 25;" text="Browse Files" />
                            </HBox>
                            <Button maxWidth="Infinity" style="-fx-background-color: #115E59; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15; -fx-font-size: 14px;" text="Submit Report to Passport" />
                        </VBox>
                    </VBox>

                </StackPane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
