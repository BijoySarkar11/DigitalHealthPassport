<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" style="-fx-background-color: linear-gradient(to right, #A3CFC0, #F8FAFC);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.admin.AdminDashboardController">

    <left>
        <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: #26463D; -fx-background-radius: 25; -fx-padding: 30 20; -fx-effect: dropshadow(three-pass-box, rgba(38, 70, 61, 0.25), 30, 0, 5, 5);">
            <BorderPane.margin><Insets bottom="25.0" left="25.0" right="10.0" top="25.0" /></BorderPane.margin>

            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 0 30 0;">
                <Label style="-fx-text-fill: #A3CFC0; -fx-font-size: 28px; -fx-font-weight: bold;" text="✚" />
                <VBox alignment="CENTER_LEFT" spacing="0">
                    <Label style="-fx-text-fill: #A3CFC0; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1;" text="DIGITAL HEALTH" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900; -fx-letter-spacing: 1;" text="PASSPORT" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 0 0 20 0;">
                <VBox alignment="CENTER" style="-fx-background-color: #A3CFC0; -fx-background-radius: 50; -fx-min-width: 45; -fx-min-height: 45;">
                    <Label style="-fx-font-size: 24px; -fx-font-family: 'Segoe UI Emoji';" text="🛡️" />
                </VBox>
                <VBox spacing="2.0">
                    <Label fx:id="adminNameLabel" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;" text="System Admin" />
                    <Label fx:id="hospitalNameLabel" style="-fx-text-fill: #A3CFC0; -fx-font-size: 11px;" text="Loading Hospital..." wrapText="true" maxWidth="150.0" />
                </VBox>
            </HBox>

            <Button fx:id="btnSearch" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showSearch" style="-fx-background-color: #1B362F; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="🔍   Search Records" />
            <Button fx:id="btnNewPatient" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showNewPatient" style="-fx-background-color: transparent; -fx-text-fill: #A3CFC0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="👤   Register Patient" />
            <Button fx:id="btnNewDoctor" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showNewDoctor" style="-fx-background-color: transparent; -fx-text-fill: #A3CFC0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="👨‍⚕️   Register Doctor" />
            <Button fx:id="btnAddTestReport" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showAddTestReport" style="-fx-background-color: transparent; -fx-text-fill: #A3CFC0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="📄   Add Test Report" />

            <VBox VBox.vgrow="ALWAYS" />

            <Button fx:id="btnLogout" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #FCA5A5; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-family: 'Segoe UI Emoji', 'System';" text="🚪   Logout" />
        </VBox>
    </left>

    <center>
        <VBox>
            <HBox style="-fx-padding: 10 0 0 0;" />

            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                <StackPane style="-fx-background-color: transparent;">

                    <VBox fx:id="viewSearch" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;">
                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 32px;" text="Database Search" />
                            <Label style="-fx-text-fill: #4A7A68; -fx-font-size: 16px; -fx-font-weight: bold;" text="Manage and edit patient or doctor records." />
                        </VBox>

                        <VBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                <TextField fx:id="dbSearchField" promptText="Search globally by Name or ID..." style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                <Button onAction="#handleSearch" style="-fx-background-color: #115E59; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 12 30; -fx-cursor: hand;" text="Search" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 5 0 10 0;">
                                <Button fx:id="btnTabDoctors" text="Doctors" onAction="#showDoctorsTab" style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-font-family: 'System';" />
                                <Button fx:id="btnTabPatients" text="Patients" onAction="#showPatientsTab" style="-fx-background-color: white; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand; -fx-border-color: #E2E8F0; -fx-border-radius: 20; -fx-font-family: 'System';" />
                            </HBox>

                            <StackPane alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
                                <VBox fx:id="subViewDoctors" spacing="15.0" VBox.vgrow="ALWAYS">
                                    <VBox fx:id="doctorRecordsContainer" spacing="15.0" />
                                </VBox>
                                <VBox fx:id="subViewPatients" visible="false" managed="false" spacing="15.0" VBox.vgrow="ALWAYS">
                                    <VBox fx:id="patientRecordsContainer" spacing="15.0" />
                                </VBox>
                            </StackPane>
                        </VBox>
                    </VBox>

                    <VBox fx:id="viewNewPatient" managed="false" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;" visible="false">
                        <VBox spacing="5.0">
                            <Label fx:id="lblPatientFormTitle" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 32px;" text="Register New Patient" />
                            <Label style="-fx-text-fill: #4A7A68; -fx-font-size: 16px; -fx-font-weight: bold;" text="Create or edit a Digital Health Passport for a patient." />
                        </VBox>

                        <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);" VBox.vgrow="ALWAYS">
                            <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 16px; -fx-text-fill: #111827; -fx-font-weight: bold;" text="Personal Information" />
                                    <TextField fx:id="patFullNameField" promptText="Full Name" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />

                                    <HBox spacing="15.0">
                                        <DatePicker fx:id="patDobPicker" maxWidth="Infinity" prefWidth="500.0" prefHeight="42.0" promptText="Date of Birth" HBox.hgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;"/>
                                        <ComboBox fx:id="patGenderCombo" maxWidth="Infinity" prefWidth="500.0" prefHeight="42.0" promptText="Select Gender" HBox.hgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;"/>
                                    </HBox>

                                    <TextField fx:id="patPhoneField" promptText="Phone Number" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />

                                    <ComboBox fx:id="patBloodCombo" maxWidth="Infinity" prefWidth="1000.0" prefHeight="42.0" promptText="Blood Group" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />

                                    <HBox spacing="15.0">
                                        <TextField fx:id="patWeightField" promptText="Weight in kg (e.g. 70.5)" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="patHeightField" promptText="Height in cm (e.g. 175)" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                    </HBox>

                                    <TextField fx:id="patInitialDiagnosisField" promptText="Initial Diagnostic History (Optional)" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                                </VBox>

                                <VBox spacing="15.0" HBox.hgrow="NEVER" minWidth="340.0" prefWidth="340.0" maxWidth="340.0">
                                    <Label style="-fx-font-size: 16px; -fx-text-fill: #111827; -fx-font-weight: bold;" text="System Credentials" />

                                    <VBox spacing="5.0">
                                        <Label fx:id="patIdLabel" style="-fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-font-size: 12px;" text="Assigned System ID (Auto-Generated)" />
                                        <TextField fx:id="patIdField" editable="false" promptText="Loading ID..." style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-padding: 12; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                    </VBox>

                                    <VBox spacing="5.0" style="-fx-padding: 10 0 0 0;">
                                        <Label style="-fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-font-size: 12px;" text="Temporary System Password" />
                                        <TextField fx:id="patPasswordField" promptText="Assign Password" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                                    </VBox>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_RIGHT" spacing="20.0">
                                <Label fx:id="patStatusLabel" text="" style="-fx-font-size: 13px;" wrapText="true" />
                                <Button fx:id="btnSubmitPatient" onAction="#handleRegisterPatient" style="-fx-background-color: #115E59; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 15 40; -fx-font-weight: bold; -fx-cursor: hand;" text="Confirm &amp; Register Patient" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox fx:id="viewNewDoctor" managed="false" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;" visible="false">
                        <VBox spacing="5.0">
                            <Label fx:id="lblDoctorFormTitle" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 32px;" text="Onboard New Doctor" />
                            <Label style="-fx-text-fill: #4A7A68; -fx-font-size: 16px; -fx-font-weight: bold;" text="Add or edit a physician in the hospital roster." />
                        </VBox>

                        <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);" VBox.vgrow="ALWAYS">
                            <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 16px; -fx-text-fill: #111827; -fx-font-weight: bold;" text="Professional Details" />
                                    <TextField fx:id="docNameField" promptText="Doctor Name (Full Legal Name)" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                                    <HBox spacing="15.0">
                                        <TextField fx:id="docSpecialtyField" promptText="Specialty (e.g. Cardiology)" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="docLicenseField" promptText="License Number" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                    <HBox spacing="15.0">
                                        <TextField fx:id="docDegreesField" promptText="Degrees (MBBS, MD, etc.)" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="docExperienceField" promptText="Years of Experience" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                </VBox>

                                <VBox spacing="15.0" HBox.hgrow="NEVER" minWidth="340.0" prefWidth="340.0" maxWidth="340.0">
                                    <Label style="-fx-font-size: 16px; -fx-text-fill: #111827; -fx-font-weight: bold;" text="System Credentials" />

                                    <VBox spacing="5.0">
                                        <Label fx:id="docIdLabel" style="-fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-font-size: 12px;" text="Assigned System ID (Auto-Generated)" />
                                        <TextField fx:id="docIdField" editable="false" promptText="Loading ID..." style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-padding: 12; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                    </VBox>

                                    <VBox spacing="5.0" style="-fx-padding: 10 0 0 0;">
                                        <Label style="-fx-text-fill: #5C8D7D; -fx-font-weight: bold; -fx-font-size: 12px;" text="Temporary System Password" />
                                        <TextField fx:id="docPasswordField" promptText="Assign Password" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                                    </VBox>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_RIGHT" spacing="20.0">
                                <Label fx:id="docStatusLabel" text="" style="-fx-font-size: 13px;" wrapText="true" />
                                <Button fx:id="btnSubmitDoctor" onAction="#handleRegisterDoctor" style="-fx-background-color: #115E59; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 15 40; -fx-font-weight: bold; -fx-cursor: hand;" text="Register Doctor to System" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox fx:id="viewAddTestReport" managed="false" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;" visible="false">
                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 32px;" text="Upload Test Report" />
                            <Label style="-fx-text-fill: #4A7A68; -fx-font-size: 16px; -fx-font-weight: bold;" text="Attach verified lab results to a patient's passport." />
                        </VBox>

                        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);" VBox.vgrow="ALWAYS">
                            <HBox spacing="15.0" alignment="CENTER_LEFT">
                                <TextField fx:id="testPatientIdField" promptText="Enter Patient ID (e.g. PT-0025235)" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                <Button onAction="#handleVerifyPatient" style="-fx-background-color: #E8F3EE; -fx-text-fill: #115E59; -fx-font-weight: bold; -fx-padding: 0 25; -fx-min-height: 45; -fx-cursor: hand;" text="Verify ID" />
                            </HBox>

                            <Label fx:id="testVerificationLabel" text="Please verify a Patient ID before uploading." style="-fx-text-fill: #F59E0B; -fx-font-size: 13px; -fx-font-weight: bold;" />

                            <HBox spacing="15.0">
                                <ComboBox fx:id="testTypeCombo" maxWidth="Infinity" prefWidth="500.0" prefHeight="42.0" promptText="Select Test Type" HBox.hgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                                <DatePicker fx:id="testDatePicker" maxWidth="Infinity" prefWidth="500.0" prefHeight="42.0" promptText="Date of Test" HBox.hgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" />
                            </HBox>

                            <TextArea fx:id="testSummaryArea" prefRowCount="5" promptText="Enter Brief Results / Summary..." style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS" />

                            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #F8FAFC; -fx-border-style: dashed; -fx-border-color: #CBD5E1; -fx-border-radius: 10; -fx-padding: 20;">
                                <Label style="-fx-font-size: 24px; -fx-font-family: 'Segoe UI Emoji'; -fx-text-fill: #475569;" text="📄" />
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label fx:id="fileSelectedLabel" style="-fx-font-weight: bold; -fx-text-fill: #111827;" text="No file selected" />
                                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Max file size: 10MB (PDF, PNG, JPG)" />
                                </VBox>
                                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                    <Button fx:id="btnCancelFile" managed="false" visible="false" onAction="#handleCancelFile" style="-fx-background-color: #FEE2E2; -fx-border-color: #FCA5A5; -fx-border-radius: 8; -fx-padding: 10 15; -fx-cursor: hand; -fx-text-fill: #DC2626; -fx-font-weight: bold;" text="Remove" />
                                    <Button fx:id="btnBrowseFile" onAction="#handleBrowseFiles" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 10 25; -fx-cursor: hand; -fx-text-fill: #111827; -fx-font-weight: bold;" text="Browse Files" />
                                </HBox>
                            </HBox>

                            <Button onAction="#handleSubmitTestReport" maxWidth="Infinity" style="-fx-background-color: #115E59; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15; -fx-font-size: 14px; -fx-cursor: hand;" text="Submit Report to Passport" />
                        </VBox>
                    </VBox>

                    <VBox fx:id="viewFullProfile" managed="false" spacing="25.0" style="-fx-padding: 10 35 35 25; -fx-background-color: transparent;" visible="false">
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <Button onAction="#showSearch" style="-fx-background-color: #E2E8F0; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;" text="← Back to Search" />
                            <Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 28px;" text="System Profile Details" />
                        </HBox>

                        <VBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                <VBox fx:id="profileIconBox" alignment="CENTER" style="-fx-background-color: #F0FDF4; -fx-background-radius: 50; -fx-min-width: 80; -fx-min-height: 80;">
                                    <Label fx:id="profileIconLbl" style="-fx-font-size: 40px; -fx-font-family: 'Segoe UI Emoji'; -fx-text-fill: #1E3A8A;" text="👤" />
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label fx:id="profileNameLbl" style="-fx-font-weight: bold; -fx-font-size: 26px; -fx-text-fill: #111827;" text="Name" />
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label fx:id="profileRoleBadge" style="-fx-background-color: #DBEAFE; -fx-text-fill: #1E3A8A; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 4 10; -fx-background-radius: 5;" text="Role" />
                                        <Label fx:id="profileIdLbl" style="-fx-text-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: bold;" text="ID: " />
                                    </HBox>
                                    <Label fx:id="profileContactLbl" style="-fx-text-fill: #115E59; -fx-font-size: 13px; -fx-font-weight: bold;" text="📞 Contact" />
                                </VBox>
                                <Button onAction="#handleEditFromProfile" style="-fx-background-color: #115E59; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;" text="Edit Record" />
                            </HBox>

                            <HBox fx:id="profileInfoRow" spacing="40" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                            </HBox>

                            <HBox fx:id="profileMedicalGrid" spacing="20" VBox.vgrow="ALWAYS">
                                <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="400">
                                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #111827;" text="📋 Diagnostic History" />
                                        <VBox fx:id="profileDiagnosesContainer" spacing="10" />
                                    </VBox>
                                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);">
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #111827;" text="💊 Active Medications" />
                                        <VBox fx:id="profileMedicationsContainer" spacing="10" />
                                    </VBox>
                                </VBox>

                                <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="300">
                                    <StackPane VBox.vgrow="ALWAYS">
                                        <VBox fx:id="testReportsListWrapper" spacing="15" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);" VBox.vgrow="ALWAYS">
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #111827;" text="🔬 Test Reports" />
                                            <VBox fx:id="profileTestsContainer" spacing="10" />
                                        </VBox>

                                        <VBox fx:id="testReportDetailView" visible="false" managed="false" spacing="15" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(38,70,61,0.08), 20, 0, 5, 5);" VBox.vgrow="ALWAYS">
                                            <Button text="← Back" onAction="#hideTestReportDetails" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 12; -fx-font-size: 12px;" />
                                            <VBox spacing="5.0">
                                                <Label fx:id="reportDetailTitle" text="Report Name" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 18px;" wrapText="true" />
                                                <Label fx:id="reportDetailInfo" text="Date: ---" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" />
                                            </VBox>
                                            <VBox fx:id="reportDetailContentBox" spacing="15.0" VBox.vgrow="ALWAYS" style="-fx-padding: 5 0;" />
                                        </VBox>
                                    </StackPane>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                </StackPane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>