<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.healthpassport.ui.admin.AdminDashboardController">

    <ImageView fitWidth="${rootPane.width}" fitHeight="${rootPane.height}" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@../icons/bg.png" />
        </image>
        <effect>
            <BoxBlur height="15.0" width="15.0" iterations="3" />
        </effect>
    </ImageView>

    <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 30;">

        <HBox alignment="CENTER" spacing="10.0">
            <Label text="🛡️" style="-fx-font-size: 30px;" />
            <Label text="HOSPITAL ADMIN PORTAL" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #1E4D45; -fx-letter-spacing: 2;" />
        </HBox>

        <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">

            <VBox alignment="TOP_CENTER" minWidth="300.0" maxWidth="300.0" spacing="20.0"
                  style="-fx-background-color: #E8F3EE; -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <VBox prefHeight="20.0" />
                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="City General" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                    <Label text="Hospital Admin" style="-fx-font-size: 16px; -fx-text-fill: #5C8D7D;" />
                    <Label text="Code: CGH-001" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
                </VBox>
                <Line endX="200.0" stroke="#7DBFA6" strokeWidth="0.5" />

                <VBox spacing="10.0">
                    <Button fx:id="btnSearch" text="🔍 Search Records" onAction="#showSearch" maxWidth="Infinity"
                            style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" />

                    <Button fx:id="btnNewPatient" text="👤 Register Patient" onAction="#showNewPatient" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-background-radius: 15; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" />

                    <Button fx:id="btnNewDoctor" text="👨‍⚕️ Register Doctor" onAction="#showNewDoctor" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-background-radius: 15; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" />

                    <Button fx:id="btnAddTestReport" text="📄 Add Test Report" onAction="#showAddTestReport" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: #5C8D7D; -fx-background-radius: 15; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" />
                </VBox>

                <VBox VBox.vgrow="ALWAYS" />
                <Button text="LOG OUT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #26463D; -fx-font-weight: bold; -fx-border-color: #26463D; -fx-border-radius: 15; -fx-padding: 10; -fx-cursor: hand;" />
            </VBox>

            <VBox spacing="20.0" HBox.hgrow="ALWAYS" maxWidth="900.0"
                  style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <ScrollPane fitToWidth="true" vbarPolicy="NEVER" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <StackPane>

                        <VBox fx:id="viewSearch" spacing="25.0">
                            <Label text="Database Search" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />

                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                                <TextField promptText="Search by ID (Patient/Doctor)..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                                <ComboBox promptText="Filter: All" style="-fx-background-color: #F1F5F9; -fx-background-radius: 10;" />
                                <Button text="Search" style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" />
                            </HBox>

                            <VBox spacing="10.0">
                                <Label text="Recent Registrations" style="-fx-font-size: 14px; -fx-text-fill: #5C8D7D; -fx-font-weight: bold;" />

                                <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                                    <Label text="👨‍⚕️" style="-fx-font-size: 20px;" />
                                    <VBox>
                                        <Label text="Dr. Sarah Johnson" style="-fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                        <Label text="ID: DOC-001 • Cardiology" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" />
                                    <Button text="Edit" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-background-radius: 5;" />
                                </HBox>

                                <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                                    <Label text="👤" style="-fx-font-size: 20px;" />
                                    <VBox>
                                        <Label text="Pranty" style="-fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                                        <Label text="ID: PT-0025235 • Patient" style="-fx-font-size: 12px; -fx-text-fill: #5C8D7D;" />
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" />
                                    <Button text="Edit" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-background-radius: 5;" />
                                </HBox>
                            </VBox>
                        </VBox>

                        <VBox fx:id="viewNewPatient" spacing="25.0" visible="false">
                            <Label text="Register New Patient" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />

                            <VBox spacing="15.0" maxWidth="600.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                <Label text="Personal Information" style="-fx-font-size: 14px; -fx-text-fill: #26463D; -fx-font-weight: bold;" />
                                <TextField promptText="Full Name" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                <HBox spacing="15.0">
                                    <DatePicker promptText="Date of Birth" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10;" />
                                    <ComboBox promptText="Gender" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10;" />
                                </HBox>
                                <Label text="Contact &amp; Medical" style="-fx-font-size: 14px; -fx-text-fill: #26463D; -fx-font-weight: bold;" />
                                <TextField promptText="Phone Number" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                <TextField promptText="Address" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                <HBox spacing="15.0">
                                    <ComboBox promptText="Blood Group" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10;" />
                                    <TextField promptText="Emergency Contact" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                </HBox>
                                <Button text="Create Patient Record" maxWidth="Infinity"
                                        style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" />
                            </VBox>
                        </VBox>

                        <VBox fx:id="viewNewDoctor" spacing="25.0" visible="false">
                            <Label text="Onboard New Doctor" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />
                            <VBox spacing="15.0" maxWidth="600.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                <Label text="Professional Details" style="-fx-font-size: 14px; -fx-text-fill: #26463D; -fx-font-weight: bold;" />
                                <TextField promptText="Doctor Name (e.g. Dr. John Doe)" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                <HBox spacing="15.0">
                                    <TextField promptText="Specialty (e.g. Cardiology)" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                    <TextField promptText="License Number" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                </HBox>
                                <Label text="Qualifications" style="-fx-font-size: 14px; -fx-text-fill: #26463D; -fx-font-weight: bold;" />
                                <TextField promptText="Degrees (e.g. MBBS, FCPS, MD)" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                <Label text="Account Credentials" style="-fx-font-size: 14px; -fx-text-fill: #26463D; -fx-font-weight: bold;" />
                                <TextField promptText="Hospital Email" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                <TextField promptText="Assign Temporary Password" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                <Button text="Register Doctor" maxWidth="Infinity"
                                        style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" />
                            </VBox>
                        </VBox>

                        <VBox fx:id="viewAddTestReport" spacing="25.0" visible="false">
                            <Label text="Upload Laboratory Report" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E4D45;" />

                            <VBox spacing="15.0" maxWidth="600.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">

                                <Label text="Patient &amp; Test Details" style="-fx-font-size: 14px; -fx-text-fill: #26463D; -fx-font-weight: bold;" />

                                <HBox spacing="15.0">
                                    <TextField promptText="Patient ID (e.g. PT-0025235)" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10; -fx-padding: 10;" />
                                    <Button text="Verify" style="-fx-background-color: #E8F3EE; -fx-text-fill: #26463D; -fx-background-radius: 10;" />
                                </HBox>

                                <HBox spacing="15.0">
                                    <ComboBox promptText="Select Test Type" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-radius: 10;" />
                                    <DatePicker promptText="Test Date" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-radius: 10;" />
                                </HBox>

                                <Label text="Report Content" style="-fx-font-size: 14px; -fx-text-fill: #26463D; -fx-font-weight: bold;" />

                                <TextArea promptText="Enter Brief Summary / Results / Remarks..." prefRowCount="4" wrapText="true" style="-fx-background-radius: 10;" />

                                <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #E2E8F0; -fx-border-style: dashed; -fx-border-radius: 10;">
                                    <Label text="📄 No file selected" style="-fx-text-fill: #94A3B8;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                    <Button text="Upload PDF" style="-fx-background-color: #64748B; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />
                                </HBox>

                                <Button text="Submit Report to System" maxWidth="Infinity"
                                        style="-fx-background-color: #26463D; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" />
                            </VBox>
                        </VBox>

                    </StackPane>
                </ScrollPane>
            </VBox>
        </HBox>
    </VBox>
</StackPane>